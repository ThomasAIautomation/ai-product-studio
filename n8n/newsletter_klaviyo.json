        "httpHeaderAuth": {
          "id": "{{CRED_WEBHOOK}}",
          "name": "AI Studio – webhook secret"
        }
      }
    },
    {
      "id": "n3",
      "name": "Instellingen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        100
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst preview = !!(body && body.preview);\nif (!preview && '{{KLAVIYO_LIST_ID}}'.startsWith('VUL_IN')) return []; // Klaviyo nog niet gekoppeld\nreturn [{json: {\n  preview,\n  // ▼ Invullen na koppelen van Klaviyo: ID van de lijst met ingeschreven klanten (Klaviyo → Lists & segments)\n  klaviyo_list_id: '{{KLAVIYO_LIST_ID}}',\n  from_email: '{{ADMIN_EMAIL}}',\n  from_label: 'AI Bag Studio',\n  shop_url: 'https://{{SHOP}}',\n  query: preview ? 'tag:ai-product-studio' : 'status:active tag:ai-product-studio -tag:nieuwsbrief-verstuurd'\n}}];"
      }
    },
    {
      "id": "n4",
      "name": "Shopify token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://{{SHOP}}/admin/oauth/access_token",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "grant_type",
              "value": "client_credentials"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "{{CRED_SHOPIFY}}",
          "name": "AI Studio – Shopify client credentials"
        }
      }
    },
    {
      "id": "n5",
      "name": "Nieuwe tassen ophalen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://{{SHOP}}/admin/api/{{API_VERSION}}/graphql.json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Shopify-Access-Token",
              "value": "={{ $json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: 'query($q:String!){ products(first:12, query:$q, sortKey:CREATED_AT, reverse:true){ nodes{ id title handle status descriptionHtml variants(first:1){ nodes{ price } } media(first:6){ nodes{ alt ... on MediaImage{ image{ url } } } } } } }', variables: { q: $('Instellingen').first().json.query } }) }}",
        "options": {}
      }
    },
    {
      "id": "n6",
      "name": "Nieuwsbrief opmaken",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        100
      ],
      "parameters": {
        "jsCode": "const s = $('Instellingen').first().json;\nconst nodes = ($input.first().json.data?.products?.nodes) || [];\nif (!nodes.length) return [];\nconst esc = t => String(t ?? '').replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nconst strip = h => String(h || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\nconst cards = nodes.map(p => {\n  const imgs = (p.media?.nodes || []).filter(m => m.image);\n  const sfeer = imgs.find(m => (m.alt || '').startsWith('Sfeerbeeld'));\n  const img = (sfeer || imgs[0])?.image?.url;\n  const price = p.variants?.nodes?.[0]?.price;\n  const url = `${s.shop_url}/products/${p.handle}`;\n  const firstP = (String(p.descriptionHtml || '').match(/<p[^>]*>([\\s\\S]*?)<\\/p>/i) || [])[1] || p.descriptionHtml;\n  const text = strip(firstP).slice(0, 220);\n  return `<tr><td style=\"padding:0 0 28px\">\n    ${img ? `<a href=\"${url}\"><img src=\"${img}\" width=\"560\" style=\"width:100%;max-width:560px;border-radius:10px;display:block\" alt=\"${esc(p.title)}\"></a>` : ''}\n    <h2 style=\"font-family:Georgia,serif;font-weight:normal;font-size:22px;margin:16px 0 6px;color:#1d1c1a\">${esc(p.title)}</h2>\n    <p style=\"font-family:Arial,sans-serif;font-size:14px;line-height:1.5;color:#555;margin:0 0 10px\">${esc(text)}${text.length >= 220 ? '…' : ''}</p>\n    ${price && Number(price) > 0 ? `<p style=\"font-family:Arial,sans-serif;font-size:16px;margin:0 0 12px;color:#1d1c1a\"><b>€ ${Number(price).toFixed(2).replace('.', ',')}</b></p>` : ''}\n    <a href=\"${url}\" style=\"display:inline-block;background:#2f5d50;color:#fff;text-decoration:none;font-family:Arial,sans-serif;font-size:14px;padding:11px 20px;border-radius:6px\">Bekijk de tas</a>\n  </td></tr>`;\n}).join('');\nconst n = nodes.length;\nconst subject = n === 1 ? `Nieuw binnen: ${nodes[0].title}` : `Nieuw binnen: ${n} nieuwe tassen`;\n// {% unsubscribe %} is de Klaviyo-tag voor de verplichte afmeldlink.\nconst html = `<!doctype html><html><body style=\"margin:0;background:#f6f5f2\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f6f5f2\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#fff;border-radius:12px;padding:24px 20px\">\n<tr><td style=\"padding:0 0 20px;font-family:Georgia,serif;font-size:26px;color:#1d1c1a\">AI Bag Studio</td></tr>\n<tr><td style=\"padding:0 0 24px;font-family:Arial,sans-serif;font-size:15px;color:#555\">${n === 1 ? 'Er is een nieuwe tas binnen' : `Er zijn ${n} nieuwe tassen binnen`}. Elke tas is uniek; wie het eerst komt…</td></tr>\n${cards}\n<tr><td style=\"font-family:Arial,sans-serif;font-size:11px;color:#999;padding-top:8px\">Je ontvangt deze mail omdat je je hebt ingeschreven voor onze nieuwsbrief. ${s.preview ? '[afmeldlink]' : '{% unsubscribe %}'}</td></tr>\n</table></td></tr></table></body></html>`;\nconst listId = s.klaviyo_list_id;\nreturn [{json: {\n  preview: s.preview, subject, html, product_ids: nodes.map(p => p.id), count: n,\n  tpl_body: {data: {type: 'template', attributes: {name: `Nieuw binnen ${new Date().toISOString().slice(0, 10)}`, editor_type: 'CODE', html}}},\n  campaign_body: {data: {type: 'campaign', attributes: {\n    name: `Nieuw binnen ${new Date().toISOString().slice(0, 10)}`,\n    audiences: {included: [listId]},\n    send_strategy: {method: 'immediate'},\n    'campaign-messages': {data: [{type: 'campaign-message', attributes: {definition: {channel: 'email', label: subject,\n      content: {subject, preview_text: 'Nieuwe, unieke tassen in de webshop', from_email: s.from_email, from_label: s.from_label}}}}]}\n  }}}\n}}];"
      }
    },
    {
      "id": "n7",
      "name": "Voorbeeld?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1200,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.preview }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n8",
      "name": "Voorbeeld opmaken",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        -60
      ],
      "parameters": {
        "jsCode": "const n = $input.first().json;\nreturn [{json: {subject: `[VOORBEELD] ${n.subject}`, html: n.html}}];"
      }
    },

    {
      "id": "n12",
      "name": "Template koppelen voorbereiden",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        200
      ],
      "parameters": {
        "jsCode": "const tplId = $('Klaviyo: template maken').first().json.data.id;\nconst camp = $input.first().json.data;\nconst msgId = camp.relationships['campaign-messages'].data[0].id;\nreturn [{json: {campaign_id: camp.id,\n  assign_body: {data: {type: 'campaign-message', id: msgId, relationships: {template: {data: {type: 'template', id: tplId}}}}},\n  send_body: {data: {type: 'campaign-send-job', id: camp.id}}}}];"
      }
    },

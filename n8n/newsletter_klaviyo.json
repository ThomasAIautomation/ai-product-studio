    {
      "id": "n2",
      "name": "Webhook: voorbeeld naar beheerder",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-product-studio/newsletter-preview",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },

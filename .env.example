# Kopieer naar .env en vul in. .env staat in .gitignore — nooit committen.

# --- AI (vision + teksten) ---
ANTHROPIC_API_KEY=
# Akkoord eigenaar: testen met claude-haiku-5-5. Hogere kwaliteit: claude-opus-5-5
VISION_MODEL=claude-haiku-5-5

# --- Shopify (Dev Dashboard-app "AI Product Automation") ---
SHOPIFY_SHOP=ai-bag-studio.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# --- Publicatieroute: "direct" (backend -> Shopify) of "n8n" (backend -> n8n-webhook -> Shopify) ---
PUBLISH_VIA=direct
N8N_PUBLISH_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Publiek bereikbare URL van deze backend (alleen nodig voor PUBLISH_VIA=n8n)
PUBLIC_BASE_URL=

# --- Dashboard ---
DASHBOARD_PASSWORD=
WORKERS=2
MAX_ATTEMPTS=3
